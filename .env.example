# Leave EXPO_PUBLIC_API_URL empty to run the app on built-in mock data.
# Point it at chairo-api to use the real backend (phone/emulator must reach this host):
#   iOS simulator / web: http://localhost:3000/api/v1
#   Android emulator:    http://10.0.2.2:3000/api/v1
#   Real device:         http://<your-LAN-IP>:3000/api/v1
EXPO_PUBLIC_API_URL=

# Force mocks even when an API URL is set
EXPO_PUBLIC_USE_MOCKS=false

# Shops on Home until the API ships discovery (API Phase 6). Comma-separated slugs.
EXPO_PUBLIC_FEATURED_SLUGS=chairo-demo
